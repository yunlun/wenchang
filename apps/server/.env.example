# ── 服务 ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ── MongoDB ───────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=wenchang

# ── JWT ───────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── 跨域 ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── 文昌链 ────────────────────────────────────────
WENCHANG_API_URL=https://apis.wenchang.bianjie.ai
WENCHANG_API_KEY=your-wenchang-api-key
WENCHANG_PROJECT_ID=your-project-id
WENCHANG_CLASS_ID=your-nft-class-id
WENCHANG_RECIPIENT_ADDR=your-chain-address

# ── 应用公开地址（证书核验链接） ───────────────────
APP_BASE_URL=http://localhost:3000
